!
! NX 工具 功能区选项卡（Htet 工具侧：颜色 / 显示 / 图层 / 出图 / 应用模块）
! NX 2506 只扫描 <自定义目录>\application\profiles\All\ 下的 .rtb；按钮 ID 与 startup\Htet_menu.men 一致
! 本文件是母本：安装器会把它与 格式转换 的 Format_convert.rtb 合并为单一 NX_tools.rtb（同 TITLE 的两个 rtb 不会合并）
!
TITLE NX 工具
VERSION 170

BEGIN_GROUP HTET_RBN_COLOR
LABEL 颜色

    BUTTON Htet_red
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_black
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_yellow
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_blue
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_brown
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_gray
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_green
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_orange
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_purple
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_random
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_DISPLAY
LABEL 显示

    BUTTON Htet_displayonly
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_transparent
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_notransparent
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_LAYER
LABEL 图层

    BUTTON Htet_layers
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_worklayer
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_worklayer200
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_hidealllayers
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_showalllayers
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_nextlayer
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_previouslayer
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_movetolayer255
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_DRAW
LABEL 出图

    BUTTON Htet_batch
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_stepwise
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_reset
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_APP
LABEL 应用模块

    BUTTON Htet_sniptool
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_tolerance
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_calculator
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_quickhole
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_screw
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

END_GROUP

!
! NX 工具 功能区选项卡（格式转换侧：ImportExport）
! NX 2506 只扫描 <自定义目录>\application\profiles\All\ 下的 .rtb；按钮 ID 与 startup\step_export.men 一致
! 本文件是母本：安装器把本组并入 Htet工具 的单一 NX_tools.rtb（同 TITLE 的两个 rtb 不会合并）
!

BEGIN_GROUP FORMAT_RBN_IMPORTEXPORT
LABEL 导入导出

    BUTTON FORMAT_CONVERT
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_openfolder
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

END_GROUP
