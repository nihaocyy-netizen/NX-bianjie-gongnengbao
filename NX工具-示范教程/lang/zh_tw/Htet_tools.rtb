!
! NX 工具 功能區選項卡（Htet 工具側：顏色 / 顯示 / 圖層 / 出圖 / 應用模組）
! NX 2506 只掃描 <自訂目錄>\application\profiles\All\ 下的 .rtb；按鈕 ID 與 startup\Htet_menu.men 一致
! 本檔案是母本：安裝器會把它與 格式轉換 的 Format_convert.rtb 合併為單一 NX_tools.rtb（同 TITLE 的兩個 rtb 不會合併）
!
TITLE NX 工具
VERSION 170

BEGIN_GROUP HTET_RBN_COLOR
LABEL 顏色

    BUTTON Htet_red
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_black
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_yellow
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_blue
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_brown
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_gray
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_green
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_orange
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_purple
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_random
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_DISPLAY
LABEL 顯示

    BUTTON Htet_displayonly
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_transparent
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_notransparent
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_LAYER
LABEL 圖層

    BUTTON Htet_layers
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_worklayer
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_worklayer200
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_hidealllayers
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_showalllayers
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_nextlayer
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_previouslayer
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

    BUTTON Htet_movetolayer255
    RIBBON_STYLE MEDIUM_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_DRAW
LABEL 出圖

    BUTTON Htet_batch
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_stepwise
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_reset
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

END_GROUP

BEGIN_GROUP HTET_RBN_APP
LABEL 應用模組

    BUTTON Htet_sniptool
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_tolerance
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_calculator
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_quickhole
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

    BUTTON Htet_screw
    RIBBON_STYLE ALWAYS_LARGE_IMAGE_AND_TEXT

END_GROUP
